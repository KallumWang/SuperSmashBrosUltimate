[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/cpu_setup.gd" id="1"]

[node name="CpuSetup" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.06, 0.07, 0.1, 1)

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -150.0
offset_right = 220.0
offset_bottom = 150.0
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
horizontal_alignment = 1
text = "CPU OPPONENTS"

[node name="Hint" type="Label" parent="VBox"]
horizontal_alignment = 1
autowrap_mode = 2
text = "Toggle up to 3 CPUs on, tap a swatch to cycle its character"

[node name="Rows" type="VBoxContainer" parent="VBox"]
theme_override_constants/separation = 10

[node name="Bottom" type="HBoxContainer" parent="VBox"]
theme_override_constants/separation = 16

[node name="BackButton" type="Button" parent="VBox/Bottom"]
text = "BACK"

[node name="ConfirmButton" type="Button" parent="VBox/Bottom"]
size_flags_horizontal = 3
text = "FIGHT!"

[connection signal="pressed" from="VBox/Bottom/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="VBox/Bottom/ConfirmButton" to="." method="_on_confirm_pressed"]
